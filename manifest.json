{
  "manifest_version": 3,
  "name": "Gemini Chat to PDF",
  "version": "1.0.0",
  "description": "Select messages from a Gemini conversation and save them as a clean, readable PDF.",
  "minimum_chrome_version": "110",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://gemini.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Export Gemini chat to PDF",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "content/extractor.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
